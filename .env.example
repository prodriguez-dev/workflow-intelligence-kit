# Reference for $HERMES_HOME/.env (default /home/hermes/.hermes/.env).
# Placeholder names only. Never commit real values; install.sh never writes them.
# Hermes reads this file at startup; restart the gateway after editing it:
#   hermes gateway restart
# Variable reference: https://hermes-agent.nousresearch.com/docs/reference/environment-variables

# --- Telegram (required) -----------------------------------------------------
# https://hermes-agent.nousresearch.com/docs/user-guide/messaging/telegram
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (ask @userinfobot). Comma-separate several.
# Leave nobody else on this list: v1 is single-operator.
TELEGRAM_ALLOWED_USERS=
# Chat that receives scheduled pulses. Easiest: send /sethome to the bot.
TELEGRAM_HOME_CHANNEL=

# --- Time zone (recommended) -------------------------------------------------
# IANA name used for cron schedules and timestamps, e.g. America/Denver.
HERMES_TIMEZONE=

# --- Model auth ----------------------------------------------------------------
# Nothing here. Codex OAuth is set up with `hermes model` and stored by Hermes
# in its own auth store, not in .env. See workspace-docs/BOOTSTRAP.md.

# --- Fork integrations (examples, uncomment in the fork that needs them) -------
# Request read-only scopes only. Add a write scope only when the fork's scope
# document says so, and record why.
# Read-only token for the estimate-followup skill's source, when [source]
# base_url in its config.toml points at a real CRM. Not needed for the fixture.
# ESTIMATES_API_TOKEN=
# HUBSPOT_PRIVATE_APP_TOKEN=
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
